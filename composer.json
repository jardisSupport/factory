{
    "name": "jardissupport/factory",
    "homepage": "https://jardis.io",
    "description": "PSR-11 Container with pre-registered instances and reflection fallback",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.55",
        "phpstan/phpstan": "2.1.56",
        "squizlabs/php_codesniffer": "3.13.6"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\Factory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\Factory\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/factory/issues",
        "docs": "https://docs.jardis.io/en/support/factory",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "factory",
        "container",
        "psr-11",
        "dependency-injection",
        "reflection",
        "php",
        "jardis",
        "headgent"
    ]
}
